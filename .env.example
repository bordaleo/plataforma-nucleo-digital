# Banco de dados PostgreSQL
DATABASE_URL="postgresql://semeia:semeia@localhost:5432/semeia?schema=public"

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Semeia"

# Autenticação do administrador
# SESSION_SECRET deve ser uma string longa e aleatória (mín. 32 caracteres)
SESSION_SECRET="substitua-por-uma-string-aleatoria-com-pelo-menos-32-caracteres"
ADMIN_EMAIL="admin@semeia.com.br"
ADMIN_PASSWORD="altere-esta-senha"

# Kiwify — configure quando a integração real estiver disponível
# Não inventamos campos da API. O webhook valida o segredo e persiste o payload bruto.
KIWIFY_WEBHOOK_SECRET=""
